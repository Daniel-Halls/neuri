{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neuri",
  "version": "0.1.0",
  "identifier": "ai.neuri.studio",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": null,
    "frontendDist": "../src/neuri/gui/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Neuri Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "url": "splash.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/neuri-engine"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0"
    }
  }
}
